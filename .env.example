# Copy to `.env` (or run `npm run setup`, which writes it for you).
FLARE_ACTIONS_URL=https://flare-actions.<your-subdomain>.workers.dev
RUNNER_TOKEN=paste-runner-token-here

# Optional: token for private-repo checkout on BYO runners. Not needed
# when the dashboard Connect GitHub flow is used with managed seats.
# GITHUB_TOKEN=ghp_...

# Written by `npm run setup` when the managed seats worker is provisioned:
# SEATS_TOKEN=...

# ---------------------------------------------------------------------
# Artifacts (optional; read by `npm run setup`).
# ---------------------------------------------------------------------
# Namespace that holds trunk and the agent forks.
# ARTIFACTS_NAMESPACE=flare-tournaments

# Separate namespace for preview deploys (wrangler.jsonc previews block),
# so a preview never touches production Forge repos.
# ARTIFACTS_PREVIEW_NAMESPACE=flare-forge-preview

# Pin repo data to a region: "us" or "eu". Applied when a namespace is
# CREATED and immutable afterwards — every repo in it inherits the
# setting, and both namespaces above get it. Leave unset for
# unrestricted. Changing it later means a new namespace; setup warns
# rather than pretending it took effect.
# ARTIFACTS_JURISDICTION=eu

# Stable repos to subscribe to push events (comma-separated, in
# ARTIFACTS_NAMESPACE). The account-level lifecycle subscription
# (repo.created/forked/imported/deleted) is always ensured and needs no
# list, since it reports repos that do not exist yet.
# ARTIFACTS_SUBSCRIBE_REPOS=trunk
