{
  "name": "flare-forge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Flare Forge: many AI agents on one repo. Agents declare intent before they edit, overlaps come back before code exists, only CI-verified trains move main, every line answers why. Cloudflare Workers + Artifacts, with the Flare Actions CI engine underneath.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everyai-com/flare-forge.git"
  },
  "bugs": {
    "url": "https://github.com/everyai-com/flare-forge/issues"
  },
  "homepage": "https://github.com/everyai-com/flare-forge#readme",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "token:mint": "node scripts/mint-token.mjs",
    "eval:models": "esbuild scripts/model-eval.mjs --bundle --platform=node --format=esm --outfile=/tmp/model-eval.bundle.mjs --log-level=error && node /tmp/model-eval.bundle.mjs",
    "runner": "npm --workspace apps/runner start --",
    "cli": "node --experimental-strip-types apps/cli/src/index.ts",
    "build:cli": "npm --workspace apps/cli run build",
    "pack:cli": "npm --workspace apps/cli run build && npm pack --workspace apps/cli",
    "publish:cli": "node scripts/publish-cli.mjs",
    "forge:ops-reconcile": "node scripts/forge-ops-reconcile.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types --include-runtime=false apps/worker/src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsgo --noEmit",
    "lint": "oxlint .",
    "lint:full": "eslint .",
    "check": "node scripts/check.mjs",
    "bench": "node scripts/bench.mjs",
    "forge:bench": "node --experimental-strip-types scripts/forge-bench.mjs",
    "forge:demo": "node --experimental-strip-types scripts/forge-demo.mjs",
    "forge:agents": "node --experimental-strip-types scripts/forge-agents.mjs",
    "forge:director": "node --experimental-strip-types scripts/forge-director.mjs",
    "harness": "node scripts/tournament-harness.mjs",
    "lint:openapi": "npx -y @redocly/cli lint --config .redocly.yaml openapi.yaml",
    "openapi:gen": "node scripts/gen-openapi-ts.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@types/node": "^26.6.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "isomorphic-git": "^1.43.0",
    "js-yaml": "^5.4.2",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/sandbox": "^1.0.0",
    "yaml": "^2.9.1"
  }
}
